# ===========================================
# URLs Base
# ===========================================
BASE_URL=http://localhost:5173
API_URL=http://localhost:3000
VERIFICATION_BASE_URL=http://localhost:5173/verificar

# ===========================================
# Frontend (Vite - las variables deben comenzar con VITE_)
# ===========================================
