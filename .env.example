# Copiar a .env y ajustar. Este archivo se versiona; .env NO.

# ===========================================
# Base de datos (PostgreSQL)
# docker-compose construye DATABASE_URL a partir de estas variables.
# ===========================================
POSTGRES_USER=certify
POSTGRES_PASSWORD=cambiar_password_local
POSTGRES_DB=certify

# ===========================================
# Backend
# ===========================================
NODE_ENV=development
PORT=3000
# Minimo 32 caracteres. Generar con: openssl rand -hex 64
JWT_SECRET=cambiar_por_un_valor_aleatorio_de_al_menos_32_caracteres
JWT_EXPIRATION=8h
LOG_LEVEL=info

# Origen del frontend (CORS)
FRONTEND_URL=http://localhost:5173
# URL que se incrusta en el QR de cada certificado: VERIFICATION_BASE_URL/<uuid>
VERIFICATION_BASE_URL=http://localhost:5173/verificar

# Admin inicial: el seed lo crea solo si la BD no tiene usuarios
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=cambiar_password_admin
