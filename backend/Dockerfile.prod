# Imagen de PRODUCCION. Contexto de build: raiz del repo
#   docker build -f backend/Dockerfile.prod .

# ---------- build ----------
FROM node:24-alpine AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY backend/package.json backend/
COPY frontend/package.json frontend/
RUN npm ci --workspace @certify/backend --include-workspace-root
COPY packages/shared packages/shared
COPY backend backend
WORKDIR /app/backend
# generate no se conecta a la BD, pero prisma.config.ts exige DATABASE_URL
RUN DATABASE_URL=postgresql://build:build@localhost:5432/build npx prisma generate && npm run build

# ---------- runtime ----------
FROM node:24-alpine
RUN apk add --no-cache chromium nss freetype harfbuzz ca-certificates ttf-freefont font-noto openssl
ENV NODE_ENV=production \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser \
    PUPPETEER_SKIP_DOWNLOAD=true
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY backend/package.json backend/
COPY frontend/package.json frontend/
# prisma (CLI) se necesita en runtime para `migrate deploy`
RUN npm ci --workspace @certify/backend --include-workspace-root --omit=dev && npm install --no-save prisma@$(node -p "require('./backend/package.json').devDependencies.prisma") && npm cache clean --force
COPY --from=build /app/backend/dist backend/dist
COPY --from=build /app/backend/src/generated backend/src/generated
COPY backend/prisma backend/prisma
COPY backend/prisma.config.ts backend/
COPY backend/assets backend/assets
WORKDIR /app/backend
EXPOSE 3000
# Aplica migraciones pendientes y arranca
CMD ["npm", "start"]
