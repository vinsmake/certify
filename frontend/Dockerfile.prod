# Imagen de PRODUCCION. Contexto de build: la raiz del repo (necesita packages/shared).

# ---------- Build ----------
FROM node:24-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY backend/package.json backend/
COPY frontend/package.json frontend/
RUN npm ci --workspace @certify/frontend --include-workspace-root=false --ignore-scripts
COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY frontend frontend
RUN npm run build -w @certify/frontend

# ---------- Runtime: nginx sirve el SPA y hace proxy al backend ----------
FROM nginx:1.29-alpine
COPY --from=build /app/frontend/dist /usr/share/nginx/html
COPY frontend/nginx.prod.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
